---
import Photo from './Photo.astro';
import { content, localePath, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale].hero;
---

<section class="hero on-dark" data-hero>
  <div class="hero__media" data-parallax="0.15">
    <div class="hero__zoom">
      <Photo photo="hero" tone="dark" eager class="hero__photo" />
    </div>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="container">
      <div class="hero__copy">
        <p class="hero__eyebrow hero__in" style="--d:0">
          <span class="hero__dot" aria-hidden="true"></span>
          <span class="hero__eyebrow-long">{t.eyebrowLong}</span>
          <span class="hero__eyebrow-short">{t.eyebrowShort}</span>
        </p>
        <h1 class="hero__title">
          {
            t.title.map((line, i) => (
              <span class="hero__line">
                <span class="hero__line-inner" style={`--d:${i + 1}`}>
                  {line}
                </span>
              </span>
            ))
          }
        </h1>
        <p class="hero__lead hero__in" style={`--d:${t.title.length + 1}`}>{t.lead}</p>
        <div class="hero__actions hero__in" style={`--d:${t.title.length + 2}`}>
          <a class="btn btn-primary" href={localePath(locale, '/contact/')}>{t.primary}</a>
          <a class="btn btn-outline-light" href={localePath(locale, '/insurance-and-you/')}>{t.secondary}</a>
        </div>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#main" aria-hidden="true" tabindex="-1">
    <span>{t.scroll}</span>
    <span class="hero__scroll-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: 800px;
    max-height: max(640px, 100svh);
    overflow: hidden;
    background: #2e4250;
    color: var(--white);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    will-change: transform;
  }

  /* Load: photo settles from 1.04 to 1.0 over 2.4s */
  .hero__zoom {
    position: absolute;
    inset: 0;
    animation: hero-settle 2400ms var(--ease-out) both;
  }

  .hero__zoom :global(.hero__photo) {
    position: absolute;
    inset: 0;
  }

  /* Placeholder caption sits top-right, clear of the copy */
  .hero__zoom :global(.photo__caption) {
    top: 140px;
    right: var(--gutter);
    bottom: auto;
    left: auto;
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.04);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 22, 29, 0.55) 0%,
      rgba(14, 22, 29, 0) 22%,
      rgba(14, 22, 29, 0) 42%,
      rgba(14, 22, 29, 0.78) 100%
    );
  }

  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
  }

  .hero__copy {
    max-width: 820px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 700 13px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :lang(zh) .hero__eyebrow {
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--scarlet);
    flex: none;
  }

  .hero__eyebrow-short {
    display: none;
  }

  .hero__title {
    margin-top: 28px;
    font: 400 clamp(46px, 6.875vw, 88px) / 1.04 var(--serif);
    letter-spacing: -0.01em;
  }

  :lang(zh) .hero__title {
    font-size: clamp(38px, 5.6vw, 72px);
    line-height: 1.32;
    letter-spacing: 0;
  }

  /* Each headline line rises out of its own mask */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero__line-inner {
    display: block;
    animation: hero-rise 1100ms var(--ease-out) both;
    animation-delay: calc(250ms + var(--d) * 110ms);
  }

  .hero__in {
    animation: hero-fade 1000ms var(--ease-out) both;
    animation-delay: calc(250ms + var(--d) * 110ms);
  }

  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__lead {
    margin-top: 28px;
    max-width: 560px;
    font: 400 21px/1.6 var(--sans);
  }

  :lang(zh) .hero__lead {
    font-size: 20px;
    line-height: 1.75;
  }

  .hero__actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Scroll cue: label over a line with a light travelling down it */
  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: var(--white);
    font: 700 11px/1 'Lato', var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    animation: hero-fade 1000ms var(--ease-out) 1200ms both;
  }

  .hero__scroll:hover {
    color: var(--white);
  }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.3);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-100%);
    animation: scroll-cue 2400ms var(--ease-in-out) 1800ms infinite;
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    55% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 1023px) {
    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      height: 680px;
      max-height: max(560px, 100svh);
    }

    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgba(14, 22, 29, 0.55) 0%,
        rgba(14, 22, 29, 0) 18%,
        rgba(14, 22, 29, 0) 30%,
        rgba(14, 22, 29, 0.82) 100%
      );
    }

    .hero__zoom :global(.photo__caption) {
      top: 84px;
    }

    .hero__content {
      bottom: 36px;
    }

    .hero__eyebrow {
      font-size: 11px;
    }

    .hero__dot {
      width: 8px;
      height: 8px;
    }

    .hero__eyebrow-long {
      display: none;
    }

    .hero__eyebrow-short {
      display: inline;
    }

    .hero__title {
      margin-top: 18px;
      line-height: 1.06;
    }

    :lang(zh) .hero__title {
      line-height: 1.38;
    }

    .hero__lead,
    :lang(zh) .hero__lead {
      margin-top: 18px;
      font-size: 17px;
    }

    .hero__actions {
      margin-top: 28px;
      flex-direction: column;
      gap: 12px;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
