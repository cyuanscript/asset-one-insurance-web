---
/**
 * /contact/ — ways to reach us and the consultation request form.
 *
 * Order: compact band hero (the homepage Lake Washington photo); a two-column section with the contact
 * details (address, phone, email, hours, languages) beside the request
 * form, both on white bordered cards modelled on assetone.com/contact; a three-step "what happens next"
 * strip; then the shared FAQ. No closing "Let's talk" band: this page is
 * where that band would send people.
 *
 * Copy lives in src/i18n/contact.ts; address and phone in `contact`
 * (src/i18n/content.ts).
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import BandHero from '../news/BandHero.astro';
import Faq from '../service/Faq.astro';
import { contactCopy } from '../../i18n/contact';
import { contact, localePath, type Locale } from '../../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = contactCopy[locale];
const f = t.form;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${contact.street}, ${contact.city}`)}`;
const emailIsPlaceholder = t.reach.emailAddress.startsWith('[PLACEHOLDER]');
const emailAddress = t.reach.emailAddress.replace('[PLACEHOLDER] ', '');
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} />
  <main class="service-page contact-page" id="main">
    <BandHero eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} photo="hero" />

    <section class="section section--white contact" aria-labelledby="form-title">
      <div class="container contact__grid">
        <!-- Ways to reach us -->
        <aside class="reach" aria-labelledby="reach-title" data-reveal>
          <h2 class="reach__title" id="reach-title">{t.reach.title}</h2>

          <dl class="reach__list">
            <div class="reach__item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
              <dt>{t.reach.office}</dt>
              <dd>
                <address>
                  Asset One Insurance<br />
                  {contact.street}<br />
                  {contact.city}
                </address>
                <a class="reach__link" href={mapsHref} target="_blank" rel="noopener">
                  {t.reach.directions} <span aria-hidden="true">↗</span>
                </a>
              </dd>
            </div>

            <div class="reach__item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h3.5l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3L20 15.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" /></svg>
              <dt>{t.reach.phone}</dt>
              <dd><a class="reach__big" href={contact.phoneHref}>{contact.phone}</a></dd>
            </div>

            <div class="reach__item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
              <dt>{t.reach.email}</dt>
              <dd>
                <a class="reach__email" href={`mailto:${emailAddress}`}>{emailAddress}</a>
                {emailIsPlaceholder && <span class="reach__placeholder">[PLACEHOLDER]</span>}
              </dd>
            </div>

            <div class="reach__item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
              <dt>{t.reach.hours}</dt>
              <dd>{t.reach.hoursLines.map((line) => <span class="reach__line">{line}</span>)}</dd>
            </div>

            <div class="reach__item">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z" /><path d="M8 9.5h8M8 12.5h5" /></svg>
              <dt>{t.reach.languages}</dt>
              <dd>{t.reach.languagesValue}</dd>
            </div>
          </dl>
        </aside>

        <!-- Request form -->
        <div class="request" data-reveal style="--reveal-delay:120ms">
          <form
            class="request__form"
            novalidate
            aria-labelledby="form-title"
            data-contact-form
            data-busy={f.sending}
          >
            <p class="eyebrow">{f.eyebrow}</p>
            <h2 class="h2 request__title" id="form-title">{f.title}</h2>

            <p class="request__summary" role="alert" data-summary hidden>{f.errorSummary}</p>

            <div class="request__fields">
              <div class="field field--half">
                <label for="c-name">{f.name.label} <span class="field__req" aria-hidden="true">*</span></label>
                <input id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="c-name-err" />
                <p class="field__error" id="c-name-err" data-error={f.name.error}></p>
              </div>

              <div class="field field--half">
                <label for="c-email">{f.email.label} <span class="field__req" aria-hidden="true">*</span></label>
                <input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="c-email-err" />
                <p class="field__error" id="c-email-err" data-error={f.email.error}></p>
              </div>

              <div class="field field--half">
                <label for="c-phone">{f.phone.label}</label>
                <input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={f.phone.placeholder} />
              </div>

              <div class="field field--half">
                <label for="c-interest">{f.interest.label}</label>
                <div class="field__select">
                  <select id="c-interest" name="interest">
                    {f.interest.options.map((o) => <option>{o}</option>)}
                  </select>
                </div>
              </div>

              <fieldset class="field field--half choice">
                <legend>{f.contactBy.label}</legend>
                <div class="choice__row">
                  {
                    f.contactBy.options.map((o, i) => (
                      <label class="choice__pill">
                        <input type="radio" name="contact_by" value={o} checked={i === f.contactBy.options.length - 1} />
                        <span>{o}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>

              <fieldset class="field field--half choice">
                <legend>{f.language.label}</legend>
                <div class="choice__row">
                  {
                    f.language.options.map((o, i) => (
                      <label class="choice__pill">
                        <input type="radio" name="language" value={o} checked={locale === 'zh' ? i === 1 : i === 0} />
                        <span>{o}</span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>

              <div class="field">
                <label for="c-message">{f.message.label}</label>
                <textarea id="c-message" name="message" rows="5" placeholder={f.message.placeholder}></textarea>
              </div>
            </div>

            <button class="btn btn-primary request__submit" type="submit">{f.submit}</button>
          </form>

          <div class="request__success" data-success hidden tabindex="-1">
            <svg class="request__check" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="22" />
              <path d="m15 24.5 6 6 12-13" />
            </svg>
            <h2 class="request__success-title">{f.successTitle}</h2>
            <p class="lead-text">
              {f.successBody} <a href={contact.phoneHref}>{contact.phone}</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--pale next" aria-labelledby="next-title">
      <div class="container">
        <div class="next__head" data-reveal>
          <p class="eyebrow">{t.next.eyebrow}</p>
          <h2 class="h2 next__title" id="next-title">{t.next.title}</h2>
        </div>
        <ol class="next__steps" role="list">
          {
            t.next.steps.map((s, i) => (
              <li class="next__step" data-reveal style={`--reveal-delay:${i * 100}ms`}>
                <span class="next__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="next__step-title">{s.title}</h3>
                <p class="next__step-body">{s.body}</p>
              </li>
            ))
          }
        </ol>
        <p class="next__more" data-reveal>
          <a href={localePath(locale, t.next.more.href)}>
            {t.next.more.label} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <div class="contact-faq">
      <Faq t={t.faq} />
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  /* ---------- Layout ---------- */
  .contact__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  /* ---------- Cards ----------
     Both columns are white cards with a hairline border and a soft
     radius, after assetone.com/contact. */
  .reach,
  .request {
    padding: clamp(28px, 3.5vw, 48px);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--white);
  }

  /* ---------- Reach Us card ---------- */
  .reach {
    position: sticky;
    top: 104px;
  }

  .reach__title {
    font: 400 clamp(30px, 3vw, 38px) / 1.2 var(--serif);
    color: var(--ink);
  }

  :lang(zh) .reach__title {
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.45;
  }

  .reach__list {
    display: grid;
    gap: 28px;
    margin: 36px 0 0;
  }

  /* Icon in its own column, label and value stacked beside it */
  .reach__item {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    column-gap: 14px;
  }

  .reach__item svg {
    grid-row: 1 / span 2;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    fill: none;
    stroke: var(--deep-sky);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .reach__item dt {
    font: 700 17px/1.5 var(--sans);
    color: var(--deep-sky);
  }

  .reach__item dt::after {
    content: ':';
  }

  :lang(zh) .reach__item dt::after {
    content: '：';
  }

  .reach__item dd {
    grid-column: 2;
    margin: 2px 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  .reach__item address {
    font-style: normal;
  }

  .reach__line {
    display: block;
  }

  .reach__item dd a:not(.reach__link) {
    color: var(--ink);
  }

  .reach__item dd a:not(.reach__link):hover {
    color: var(--deep-sky);
  }

  .reach__email {
    overflow-wrap: anywhere;
  }

  .reach__placeholder {
    display: block;
    font-size: 12px;
    color: var(--slate);
  }

  .reach__link {
    display: inline-block;
    margin-top: 6px;
    font: 700 14px/1.4 var(--sans);
    color: var(--deep-sky);
  }

  /* ---------- Form card ---------- */
  .request__title {
    margin-top: 14px;
    font-size: clamp(32px, 3.4vw, 44px);
  }

  :lang(zh) .request__title {
    font-size: clamp(26px, 3vw, 38px);
  }

  .request__summary {
    margin-top: 20px;
    padding: 12px 16px;
    border-left: 3px solid var(--deep-red);
    background: #fdf1f1;
    font: 700 15px/1.5 var(--sans);
    color: var(--deep-red);
  }

  .request__summary[hidden] {
    display: none;
  }

  .request__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 20px;
    margin-top: 28px;
  }

  .field {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .field--half {
    grid-column: span 1;
  }

  .field label,
  .field legend {
    margin-bottom: 8px;
    padding: 0;
    font: 700 14px/1.4 var(--sans);
    color: var(--ink);
  }

  .field__req {
    color: var(--scarlet);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 16px;
    border: 1.5px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--cloud);
    font: 400 16px/1.5 var(--sans);
    color: var(--ink);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 132px;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #8a96a3;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: #b9c7d4;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--deep-sky);
    background: var(--white);
    box-shadow: 0 0 0 3px rgba(44, 153, 214, 0.18);
  }

  .field input[aria-invalid='true'] {
    border-color: var(--deep-red);
    background: #fffafa;
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    appearance: none;
    padding-right: 44px;
    cursor: pointer;
  }

  .field__select::after {
    content: '';
    position: absolute;
    right: 18px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -6px;
    border-right: 2px solid var(--deep-sky);
    border-bottom: 2px solid var(--deep-sky);
    transform: rotate(45deg);
    pointer-events: none;
  }

  .field__error {
    min-height: 0;
    margin-top: 6px;
    font: 700 13px/1.4 var(--sans);
    color: var(--deep-red);
  }

  .field__error:empty {
    display: none;
  }

  /* Pill radios */
  .choice__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choice__pill {
    position: relative;
    margin: 0 !important;
    font-weight: 400 !important;
    cursor: pointer;
  }

  .choice__pill input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    min-height: 0;
  }

  .choice__pill span {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--hairline);
    border-radius: 999px;
    background: var(--cloud);
    font: 400 15px/1 var(--sans);
    color: var(--slate);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      color 200ms ease;
  }

  .choice__pill:hover span {
    border-color: #b9c7d4;
  }

  .choice__pill input:checked + span {
    border-color: var(--deep-sky);
    background: var(--pale-sky);
    color: var(--deep-sky);
    font-weight: 700;
  }

  .choice__pill input:focus-visible + span {
    outline: 2px solid var(--deep-sky);
    outline-offset: 3px;
  }

  /* Send button, after assetone.com/contact: Lato regular in caps,
     shorter and lighter than the site's big CTA buttons. Colour stays
     the site's scarlet (.btn-primary). */
  .request__submit {
    height: 46px;
    margin-top: 28px;
    padding: 0 26px;
    font: 400 16px/1 var(--sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .request__submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }

  /* Success */
  .request__success {
    padding: clamp(24px, 4vw, 48px) 0;
    text-align: center;
  }

  .request__success:focus {
    outline: none;
  }

  .request__success[hidden] {
    display: none;
  }

  .request__check {
    width: 64px;
    height: 64px;
    margin: 0 auto;
    fill: none;
    stroke: var(--deep-sky);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .request__check path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: contact-check 700ms 200ms var(--ease-out) forwards;
  }

  @keyframes contact-check {
    to {
      stroke-dashoffset: 0;
    }
  }

  .request__success-title {
    margin-top: 24px;
    font: 400 clamp(26px, 2.8vw, 34px) / 1.25 var(--serif);
    color: var(--ink);
  }

  .request__success .lead-text {
    max-width: 440px;
    margin: 14px auto 0;
  }

  /* ---------- What happens next ---------- */
  .next__title {
    margin-top: 16px;
  }

  .next__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 32px);
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .next__step {
    padding: 32px 28px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .next__num {
    display: block;
    font: 400 40px/1 var(--serif);
    color: var(--sky);
  }

  .next__step-title {
    margin-top: 18px;
    font: 700 19px/1.35 var(--sans);
    color: var(--ink);
  }

  .next__step-body {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--slate);
  }

  .next__more {
    margin-top: 32px;
  }

  .next__more a {
    font: 700 15px/1.4 var(--sans);
    color: var(--deep-sky);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* FAQ sits on white here */
  .contact-faq :global(.faq) {
    background: var(--white);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 959px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Form first on small screens; contact details follow */
    .request {
      order: -1;
    }

    .reach {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .next__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .request__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .field--half {
      grid-column: 1 / -1;
    }

    .reach,
    .request {
      padding: 28px 20px;
    }

    .request__submit {
      width: 100%;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const wrap = form.parentElement!;
    const success = wrap.querySelector<HTMLElement>('[data-success]')!;
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent ?? '';
    const required = Array.from(form.querySelectorAll<HTMLInputElement>('input[required]'));

    const check = (input: HTMLInputElement) => {
      const ok = input.value.trim() !== '' && input.validity.valid;
      const err = document.getElementById(input.getAttribute('aria-describedby') ?? '');
      input.setAttribute('aria-invalid', String(!ok));
      if (err) err.textContent = ok ? '' : (err.dataset.error ?? '');
      return ok;
    };

    required.forEach((input) => {
      input.addEventListener('blur', () => {
        if (input.value.trim()) check(input);
      });
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') check(input);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = required.filter((input) => !check(input));
      if (invalid.length) {
        summary.hidden = false;
        invalid[0].focus();
        return;
      }
      summary.hidden = true;
      button.disabled = true;
      button.textContent = form.dataset.busy ?? label;

      // TODO: no form service is connected yet. Replace this delay with a
      // request to the provider (Formspree, Netlify Forms, a CRM webhook, etc.)
      // using `new FormData(form)`.
      await new Promise((resolve) => setTimeout(resolve, 800));

      form.hidden = true;
      success.hidden = false;
      success.focus();
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>
