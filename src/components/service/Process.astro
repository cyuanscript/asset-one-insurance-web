---
/**
 * How we work: numbered steps on a tinted photo band, then "zoom-in"
 * panels that overlap the bottom edge of the band, each tied to one step.
 *
 * Takes one or more `tracks` (Life Insurance, Health Insurance,
 * Annuities). With more than one, a three-way slider above the steps
 * switches between them: the steps, the detail panels and the background
 * photo all change together. `#life`, `#health` or `#annuities` in the URL
 * opens that track and scrolls to the band.
 *
 * Used on /our-process/. The copy for each track still lives in the
 * matching Services page file (process + processDetails).
 */
import Photo from '../Photo.astro';
import SectionHeading from '../SectionHeading.astro';
import type { ProcessCopy, ProcessTrack } from '../../i18n/service-types';

interface Props {
  heading: { eyebrow: string; title: string; intro: string };
  /** Accessible name for the slider, e.g. "Choose a service" */
  switchLabel?: string;
  tracks: ProcessTrack[];
}
const { heading, switchLabel = '', tracks } = Astro.props;
const multi = tracks.length > 1;
const stepLabel = (t: ProcessCopy, n: number) => t.stepLabel.replace('{n}', String(n));
---

<section class="section section--white process" aria-labelledby="process-title" id="steps" data-process>
  <div class="process__band on-dark">
    <div class="process__media" aria-hidden="true">
      {
        tracks.map((tr, i) => (
          <div class:list={['process__layer', { 'is-active': i === 0 }]} data-layer={tr.key}>
            <Photo photo={tr.photo} tone="dark" class="process__photo" />
          </div>
        ))
      }
    </div>
    <div class="process__tint" aria-hidden="true"></div>

    <div class="container process__band-inner">
      <SectionHeading eyebrow={heading.eyebrow} title={heading.title} intro={heading.intro} id="process-title" span={6} />

      {
        multi && (
          <div class="switch" role="tablist" aria-label={switchLabel} style={`--n:${tracks.length};--i:0`} data-switch data-reveal>
            <span class="switch__thumb" aria-hidden="true" />
            {tracks.map((tr, i) => (
              <button
                type="button"
                class="switch__btn"
                role="tab"
                id={`process-tab-${tr.key}`}
                aria-controls={`process-panel-${tr.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-track={tr.key}
              >
                {tr.label}
              </button>
            ))}
          </div>
        )
      }

      {
        tracks.map((tr, ti) => (
          <div
            class="process__panel"
            id={`process-panel-${tr.key}`}
            role={multi ? 'tabpanel' : undefined}
            aria-labelledby={multi ? `process-tab-${tr.key}` : undefined}
            data-panel={tr.key}
            hidden={ti !== 0}
          >
            <ol class="steps">
              {tr.t.steps.map((s, i) => {
                const hasDetail = (tr.details ?? []).some((d) => d.step === i + 1);
                return (
                  <li class:list={['step', { 'step--detail': hasDetail }]} data-reveal style={`--reveal-delay:${i * 90}ms;--i:${i}`}>
                    <span class="step__num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <h3 class="step__title">{s.title}</h3>
                    <p class="step__body">{s.body}</p>
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
    </div>
  </div>

  <div class="container">
    {
      tracks.map((tr, ti) => (
        <div class="process__details" data-details={tr.key} hidden={ti !== 0}>
          {(tr.details ?? []).length > 0 && (
            <div class="details">
              {(tr.details ?? []).map((d, i) => (
                <section class="detail" aria-labelledby={`detail-${tr.key}-${d.step}-title`} data-reveal style={`--reveal-delay:${i * 120}ms;--i:${i}`}>
                  <p class="detail__step">
                    {stepLabel(tr.t, d.step)} · {tr.t.steps[d.step - 1].title}
                  </p>
                  <h3 class="detail__title" id={`detail-${tr.key}-${d.step}-title`}>
                    {d.title}
                  </h3>
                  {d.intro && <p class="detail__intro">{d.intro}</p>}
                  {d.numbered ? (
                    <ol class="detail__list detail__list--numbered">
                      {d.items.map((q) => (
                        <li>{q}</li>
                      ))}
                    </ol>
                  ) : (
                    <ul class="detail__list">
                      {d.items.map((a) => (
                        <li>{a}</li>
                      ))}
                    </ul>
                  )}
                  {d.outro && <p class="detail__outro">{d.outro}</p>}
                </section>
              ))}
            </div>
          )}
          {tr.link && (
            <p class="process__more">
              <a class="text-link" href={tr.link.href}>
                {tr.link.label} <span aria-hidden="true">→</span>
              </a>
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Photo band: full bleed, tinted deep blue so the photo reads as texture */
  .process {
    padding-top: 0;
    scroll-margin-top: 0;
  }

  .process__band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--section-y) 0 calc(var(--section-y) + 88px);
    background: var(--ink);
  }

  .process__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  /* One photo per track; the active one fades in */
  .process__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .process__layer.is-active {
    opacity: 1;
  }

  .process__layer :global(.process__photo) {
    position: absolute;
    inset: 0;
  }

  .process__tint {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(12, 30, 46, 0.94) 0%, rgba(14, 48, 76, 0.88) 50%, rgba(26, 102, 153, 0.8) 100%);
  }

  /* Heading colours on the dark band */
  .process__band :global(.eyebrow) {
    color: var(--light-blue);
  }

  .process__band :global(.h2) {
    color: var(--white);
  }

  .process__band :global(.section-heading__intro) {
    color: rgba(255, 255, 255, 0.82);
  }

  /* ---------- Three-way slider ---------- */
  .switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    width: min(100%, 600px);
    margin-top: 48px;
    padding: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .switch__thumb {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 5px;
    width: calc((100% - 10px) / var(--n));
    border-radius: 999px;
    background: var(--white);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transform: translateX(calc(var(--i) * 100%));
    transition: transform 450ms var(--ease-out);
  }

  .switch__btn {
    position: relative;
    z-index: 1;
    min-height: 46px;
    padding: 10px 14px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgba(255, 255, 255, 0.86);
    font: 700 15px/1.2 var(--sans);
    cursor: pointer;
    transition: color 300ms ease;
  }

  .switch__btn:hover {
    color: var(--white);
  }

  .switch__btn[aria-selected='true'] {
    color: var(--deep-sky);
  }

  .switch__btn:focus-visible {
    outline: 2px solid var(--light-blue);
    outline-offset: 2px;
  }

  /* ---------- Steps ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
  }

  .switch + .process__panel .steps {
    margin-top: 40px;
  }

  .step {
    position: relative;
    padding-top: 24px;
    border-top: 2px solid rgba(255, 255, 255, 0.22);
  }

  /* Small Scarlet marker on the line for each step */
  .step::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2px;
    width: 40px;
    height: 2px;
    background: var(--scarlet);
  }

  .step__num {
    font: 700 13px/1 'Lato', var(--sans);
    letter-spacing: 0.12em;
    color: var(--light-blue);
  }

  /* Steps with a detail panel below get a filled number */
  .step--detail .step__num {
    display: inline-block;
    padding: 5px 8px;
    border-radius: 999px;
    background: rgba(123, 201, 255, 0.16);
  }

  .step__title {
    margin-top: 14px;
    font: 400 22px/1.25 var(--serif);
    color: var(--white);
  }

  :lang(zh) .step__title {
    font-size: 21px;
    line-height: 1.45;
  }

  .step__body {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  /* Switching tracks: the new steps and panels rise in, staggered */
  .is-entering .step,
  .is-entering .detail {
    animation: process-in 600ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }

  @keyframes process-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Detail panels: overlap the bottom of the photo band ---------- */
  .details {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: -88px;
  }

  .detail {
    padding: clamp(24px, 3.5vw, 40px);
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .detail__step {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--pale-sky);
    font: 700 12px/1.3 var(--sans);
    letter-spacing: 0.04em;
    color: var(--deep-sky);
  }

  .detail__title {
    margin-top: 16px;
    font: 400 clamp(26px, 2.6vw, 32px) / 1.2 var(--serif);
    color: var(--sky);
  }

  :lang(zh) .detail__title {
    line-height: 1.45;
  }

  .detail__intro {
    margin-top: 12px;
    font-size: 16px;
    color: var(--slate);
  }

  .detail__list {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-size: 16px;
    line-height: 1.55;
  }

  .detail__list li {
    position: relative;
    padding: 12px 0 12px 28px;
    border-top: 1px solid var(--hairline);
  }

  .detail__list li:first-child {
    border-top: 0;
  }

  .detail__list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 21px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sky);
  }

  .detail__list--numbered {
    counter-reset: q;
  }

  .detail__list--numbered li {
    counter-increment: q;
  }

  .detail__list--numbered li::before {
    content: counter(q);
    top: 13px;
    left: 0;
    width: auto;
    height: auto;
    background: none;
    font: 700 13px/1.9 'Lato', var(--sans);
    color: var(--scarlet);
  }

  .detail__outro {
    margin-top: 12px;
    font: 400 19px/1.45 var(--serif);
  }

  :lang(zh) .detail__outro {
    line-height: 1.7;
  }

  .process__more {
    margin-top: 28px;
    text-align: center;
  }

  @media (max-width: 1099px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media (max-width: 899px) {
    .details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .switch {
      margin-top: 32px;
    }

    .switch__btn {
      min-height: 44px;
      padding: 8px 6px;
      font-size: 13.5px;
    }

    :lang(zh) .switch__btn {
      font-size: 14px;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 32px;
    }

    .switch + .process__panel .steps {
      margin-top: 28px;
    }

    .step {
      padding-top: 18px;
    }

    .process__band {
      padding-bottom: calc(var(--section-y) + 56px);
    }

    .details {
      margin-top: -56px;
      gap: 16px;
    }

    .detail__list {
      font-size: 15px;
    }

    .detail__outro {
      font-size: 18px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-process]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const control = root.querySelector<HTMLElement>('[data-switch]');
    if (!tabs.length || !control) return;

    const parts = (key: string) => [
      root.querySelector<HTMLElement>(`[data-panel="${key}"]`),
      root.querySelector<HTMLElement>(`[data-details="${key}"]`),
    ];

    const select = (index: number, opts: { focus?: boolean; animate?: boolean; updateHash?: boolean } = {}) => {
      const key = tabs[index].dataset.track ?? '';
      control.style.setProperty('--i', String(index));
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const k = tab.dataset.track ?? '';
        parts(k).forEach((el) => {
          if (!el) return;
          el.hidden = !on;
          if (on && opts.animate) {
            // Skip the scroll reveal for content shown by a switch; animate it instead
            el.querySelectorAll<HTMLElement>('[data-reveal]').forEach((r) => r.classList.add('is-revealed', 'is-settled'));
            el.classList.remove('is-entering');
            void el.offsetWidth;
            el.classList.add('is-entering');
          }
        });
        root.querySelector(`[data-layer="${k}"]`)?.classList.toggle('is-active', on);
      });
      if (opts.focus) tabs[index].focus();
      if (opts.updateHash) history.replaceState(null, '', `#${key}`);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, { animate: true, updateHash: true }));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, { focus: true, animate: true, updateHash: true });
      });
    });

    // #life / #health / #annuities: open that track and bring the band into view
    const fromHash = (scroll: boolean) => {
      const index = tabs.findIndex((t) => `#${t.dataset.track}` === location.hash);
      if (index < 0) return;
      select(index);
      if (!scroll) return;
      // Wait until images and fonts have settled, so the band lands in the right place
      const go = () => root.scrollIntoView({ block: 'start', behavior: 'instant' });
      if (document.readyState === 'complete') go();
      else window.addEventListener('load', go, { once: true });
    };
    fromHash(true);
    window.addEventListener('hashchange', () => fromHash(true));
  });
</script>
