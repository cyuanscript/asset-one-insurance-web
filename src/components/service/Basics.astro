---
import type { BasicsCopy } from '../../i18n/service-types';

interface Props {
  t: BasicsCopy;
}
const { t } = Astro.props;
---

<section class="section basics" aria-labelledby="basics-title" id="main">
  <div class="container basics__grid">
    <div class="basics__copy" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="h2 basics__title" id="basics-title">{t.title}</h2>
      {t.body.map((p) => <p class="lead-text basics__p">{p}</p>)}
    </div>

    <aside class="basics__check" data-reveal style="--reveal-delay:120ms" aria-labelledby="basics-check-title">
      <h3 class="basics__check-title" id="basics-check-title">{t.checklistTitle}</h3>
      <ul>
        {
          t.checklist.map((item) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M6 10.2 8.7 13 14 7.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .basics__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .basics__title {
    margin-top: 20px;
  }

  .basics__p {
    margin-top: 24px;
    max-width: 62ch;
  }

  .basics__check {
    padding: 36px 36px 32px;
    background: var(--white);
    border-radius: var(--radius);
    border-top: 3px solid var(--scarlet);
    box-shadow: var(--shadow);
  }

  .basics__check-title {
    font: 400 24px/1.3 var(--serif);
  }

  .basics__check ul {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .basics__check li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline);
    font-size: 16px;
    line-height: 1.55;
  }

  .basics__check li:first-child {
    border-top: 0;
  }

  .basics__check svg {
    flex: none;
    margin-top: 2px;
    color: var(--deep-sky);
  }

  @media (max-width: 1023px) {
    .basics__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .basics__title {
      margin-top: 14px;
    }
    .basics__p {
      margin-top: 18px;
      font-size: 16px;
    }
    .basics__check {
      padding: 24px;
    }
    .basics__check-title {
      font-size: 21px;
    }
  }
</style>
