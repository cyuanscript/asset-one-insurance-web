---
/**
 * Compact dark hero for reading pages (News index and articles).
 * Shorter than PageHero, so the reading starts sooner, and dark so the
 * transparent header stays legible. With `photo`, a Lake Washington image
 * sits behind a deep scrim; without one, a slate ground with fine water lines.
 *
 * Reusable pattern: "Band hero". Use it for any text-led page (guides,
 * legal pages, contact) where a full photo hero would be too much.
 */
import Photo from '../Photo.astro';
import type { PhotoKey } from '../../i18n/content';

interface Props {
  eyebrow: string;
  /** Link the eyebrow back to a parent page (breadcrumb) */
  eyebrowHref?: string;
  title: string;
  lead?: string;
  photo?: PhotoKey;
  /** Narrower measure for article headlines */
  narrow?: boolean;
}
const { eyebrow, eyebrowHref, title, lead, photo, narrow = false } = Astro.props;
---

<section class:list={['band-hero on-dark', { 'band-hero--photo': photo, 'band-hero--narrow': narrow }]}>
  {
    photo ? (
      <div class="band-hero__media" data-parallax="0.12">
        <Photo photo={photo} tone="dark" eager class="band-hero__photo" />
      </div>
    ) : (
      <svg class="band-hero__lines" viewBox="0 0 1200 200" preserveAspectRatio="none" aria-hidden="true">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <path d={`M0 ${70 + i * 22} C 240 ${56 + i * 22}, 420 ${88 + i * 22}, 700 ${72 + i * 22} S 1020 ${58 + i * 22}, 1200 ${76 + i * 22}`} style={`--i:${i}`} />
        ))}
      </svg>
    )
  }
  <div class="band-hero__scrim" aria-hidden="true"></div>

  <div class="container band-hero__inner">
    <div class="band-hero__copy">
      <p class="band-hero__eyebrow band-hero__in" style="--d:0">
        <span class="band-hero__dot" aria-hidden="true"></span>
        {eyebrowHref ? <a href={eyebrowHref}>{eyebrow}</a> : eyebrow}
      </p>
      <h1 class="band-hero__title band-hero__in" style="--d:1">{title}</h1>
      {lead && <p class="band-hero__lead band-hero__in" style="--d:2">{lead}</p>}
      <div class="band-hero__in" style="--d:3"><slot /></div>
    </div>
  </div>
</section>

<style>
  .band-hero {
    position: relative;
    overflow: hidden;
    padding: 176px 0 72px;
    background: linear-gradient(170deg, #263845 0%, #18242d 70%, #141b22 100%);
    color: var(--white);
  }

  .band-hero--photo {
    min-height: 520px;
    display: flex;
    align-items: flex-end;
  }

  .band-hero__media {
    position: absolute;
    inset: -40px 0 0;
    will-change: transform;
  }

  .band-hero__media :global(.band-hero__photo) {
    position: absolute;
    inset: 0;
  }

  .band-hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .band-hero--photo .band-hero__scrim {
    background: linear-gradient(180deg, rgba(14, 22, 29, 0.62) 0%, rgba(14, 22, 29, 0.35) 40%, rgba(14, 22, 29, 0.85) 100%);
  }

  .band-hero__lines {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 70%;
  }

  .band-hero__lines path {
    fill: none;
    stroke: var(--light-blue);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: calc(0.05 + var(--i) * 0.025);
  }

  .band-hero__inner {
    position: relative;
    width: 100%;
  }

  .band-hero__copy {
    max-width: 820px;
  }

  .band-hero--narrow .band-hero__copy {
    max-width: 760px;
  }

  .band-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 700 13px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :lang(zh) .band-hero__eyebrow {
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .band-hero__eyebrow a {
    color: var(--white);
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }

  .band-hero__eyebrow a:hover {
    color: var(--light-blue);
    border-bottom-color: var(--light-blue);
  }

  .band-hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--scarlet);
    flex: none;
  }

  .band-hero__title {
    margin-top: 22px;
    font: 400 clamp(38px, 4.8vw, 62px) / 1.1 var(--serif);
    letter-spacing: -0.01em;
  }

  .band-hero--narrow .band-hero__title {
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1.12;
  }

  :lang(zh) .band-hero__title {
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1.4;
    letter-spacing: 0;
  }

  :lang(zh) .band-hero--narrow .band-hero__title {
    font-size: clamp(28px, 3.6vw, 44px);
  }

  .band-hero__lead {
    margin-top: 22px;
    max-width: 640px;
    font: 400 20px/1.6 var(--sans);
    color: rgba(255, 255, 255, 0.88);
  }

  :lang(zh) .band-hero__lead {
    font-size: 18px;
    line-height: 1.8;
  }

  .band-hero__in {
    animation: band-hero-fade 1000ms var(--ease-out) both;
    animation-delay: calc(150ms + var(--d) * 110ms);
  }

  @keyframes band-hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .band-hero {
      padding: 132px 0 44px;
    }
    .band-hero--photo {
      min-height: 460px;
    }
    .band-hero__eyebrow {
      font-size: 11px;
    }
    .band-hero__title {
      margin-top: 16px;
    }
    .band-hero__lead,
    :lang(zh) .band-hero__lead {
      margin-top: 16px;
      font-size: 17px;
    }
  }
</style>
