---
/**
 * A photo slot. Shows the real image when `src` is set in
 * src/i18n/content.ts (photos), otherwise a striped placeholder
 * with a caption describing the intended shot.
 */
import { photos, type PhotoKey } from '../i18n/content';

interface Props {
  photo: PhotoKey;
  tone?: 'light' | 'dark';
  alt?: string;
  class?: string;
  eager?: boolean;
  showCaption?: boolean;
}

const { photo, tone = 'light', alt = '', class: className, eager = false, showCaption = true } = Astro.props;
const { src, caption } = photos[photo];
---

<div class:list={['photo', `photo--${tone}`, className]}>
  {
    src ? (
      <img src={src} alt={alt || caption} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="photo__placeholder" role="img" aria-label={`Photo placeholder: ${caption}`}>
        {showCaption && <span class="photo__caption">{caption}</span>}
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
  }

  .photo img,
  .photo__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo--light .photo__placeholder {
    background: repeating-linear-gradient(135deg, #d3e2ec 0 1px, #e2ecf3 1px 11px);
  }

  .photo--dark .photo__placeholder {
    background: repeating-linear-gradient(135deg, #2e4250 0 1px, #344a5a 1px 12px);
  }

  .photo__caption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    max-width: calc(100% - 32px);
    padding: 6px 10px;
    font: 11px/1.5 ui-monospace, Menlo, monospace;
    letter-spacing: 0;
    text-transform: none;
  }

  .photo--light .photo__caption {
    color: var(--slate);
    border: 1px solid rgba(75, 88, 102, 0.3);
    background: rgba(248, 250, 252, 0.6);
  }

  .photo--dark .photo__caption {
    color: #c9d6e0;
    border: 1px solid rgba(201, 214, 224, 0.4);
  }
</style>
