---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import Products from '../Products.astro';
import Basics from '../service/Basics.astro';
import TypeCards from '../service/TypeCards.astro';
import CompareTable from '../service/CompareTable.astro';
import FeatureGrid from '../service/FeatureGrid.astro';
import Process from '../service/Process.astro';
import Faq from '../service/Faq.astro';
import WhereItFits from '../service/WhereItFits.astro';
import ClosingCta from '../service/ClosingCta.astro';
import Disclosures from '../service/Disclosures.astro';
import BusinessPlanning from './BusinessPlanning.astro';
import { lifeInsurance } from '../../i18n/life-insurance';
import { localePath, type Locale } from '../../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = lifeInsurance[locale];
// The two "zoom-in" panels under How we work
const processDetails = [
  { step: t.process.amount.step, title: t.process.amount.title, intro: t.process.amount.intro, items: t.process.amount.questions, numbered: true, outro: t.process.amount.outro },
  { step: t.process.apply.step, title: t.process.apply.title, items: t.process.apply.items },
];
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} />
  <main class="life-page service-page">
    <PageHero
      eyebrow={t.hero.eyebrow}
      title={t.hero.title}
      lead={t.hero.lead}
      photo="lifeHero"
      primary={{ label: t.hero.primary, href: localePath(locale, '/contact/') }}
      secondary={{ label: t.hero.secondary, href: '#types' }}
    />
    <Basics t={t.basics} />
    <TypeCards t={t.types} />
    <CompareTable t={t.compare} />
    <FeatureGrid t={t.riders} />
    <Process t={t.process} details={processDetails} />
    <BusinessPlanning locale={locale} />
    <Faq t={t.faq} />
    <WhereItFits locale={locale} t={t.fits} />
    <Products
      locale={locale}
      only={['/services/health-insurance/', '/services/annuities/']}
      eyebrow={t.fits.relatedEyebrow}
      title={t.fits.relatedTitle}
      intro={t.fits.relatedIntro}
      id="related-title"
    />
    <ClosingCta locale={locale} t={t.cta} />
    <Disclosures t={t.disclosures} />
  </main>
  <Footer locale={locale} />
</Base>
