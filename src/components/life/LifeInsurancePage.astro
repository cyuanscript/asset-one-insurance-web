---
/**
 * /services/life-insurance/ — kept short on purpose:
 * hero → basics → coverage (cards + comparison) → riders → Let's talk → FAQ.
 * The How we work steps moved to /our-process/ (Life tab). Advanced
 * planning (BusinessPlanning.astro, copy in `business`) is archived: still
 * in the repo, not on the page. So is Where it fits (WhereItFits.astro,
 * copy in `fits.stageLinks`): the homepage "May fit" chips now link
 * straight to a card here (#term, #whole, #iul, #survivorship).
 */
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import Products from '../Products.astro';
import Basics from '../service/Basics.astro';
import TypeCards from '../service/TypeCards.astro';
import FeatureGrid from '../service/FeatureGrid.astro';
import Faq from '../service/Faq.astro';
import ClosingCta from '../service/ClosingCta.astro';
import Disclosures from '../service/Disclosures.astro';
import { lifeInsurance } from '../../i18n/life-insurance';
import { localePath, type Locale } from '../../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = lifeInsurance[locale];
---

<Base locale={locale} title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} />
  <main class="life-page service-page">
    <PageHero
      eyebrow={t.hero.eyebrow}
      title={t.hero.title}
      lead={t.hero.lead}
      photo="lifeHero"
      primary={{ label: t.hero.primary, href: localePath(locale, '/contact/') }}
      secondary={{ label: t.hero.secondary, href: '#types' }}
    />
    <Basics t={t.basics} />
    <TypeCards locale={locale} t={t.types} compare={t.compare} compareIds={['term', 'whole', 'iul']} />
    <FeatureGrid t={t.riders} />
    <ClosingCta locale={locale} t={t.cta} photo="processConsult" />
    <Faq t={t.faq} />
    <Products
      locale={locale}
      only={['/services/health-insurance/', '/services/annuities/']}
      eyebrow={t.fits.relatedEyebrow}
      title={t.fits.relatedTitle}
      intro={t.fits.relatedIntro}
      id="related-title"
    />
    <Disclosures t={t.disclosures} />
  </main>
  <Footer locale={locale} />
</Base>
