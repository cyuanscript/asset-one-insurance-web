---
import { lifeInsurance } from '../../i18n/life-insurance';
import type { Locale } from '../../i18n/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = lifeInsurance[locale].disclosures;
---

<section class="disclosures" aria-labelledby="disclosures-title">
  <div class="container">
    <h2 class="disclosures__title" id="disclosures-title">{t.title}</h2>
    <ol class="disclosures__list">{t.items.map((d) => <li>{d}</li>)}</ol>
  </div>
</section>

<style>
  .disclosures {
    padding-block: 48px 64px;
    border-top: 1px solid var(--hairline);
  }

  .disclosures__title {
    font: 700 13px/1.4 var(--sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
  }

  :lang(zh) .disclosures__title {
    font-size: 14px;
    letter-spacing: 0.04em;
  }

  .disclosures__list {
    margin: 16px 0 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
    max-width: 110ch;
    font-size: 13px;
    line-height: 1.6;
    color: var(--slate);
  }
</style>
